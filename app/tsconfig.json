{
	"extends": "$app/tsconfig",
	"include": ["src", "*"],
	// Node runs the unit tests (`npm test`) and strips their types; svelte-check would
	// need @types/node for `node:test`, which the app doesn't otherwise use.
	"exclude": ["src/**/*.test.ts"],
	"compilerOptions": {
		"allowJs": true,
		"checkJs": true,
		"strict": true,
		// route.ts imports locked.ts with its extension, so Node's test runner can load it
		// (Vite resolves either way; nothing is emitted).
		"allowImportingTsExtensions": true
	}
}
