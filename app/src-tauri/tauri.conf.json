{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "fin-manager",
  "version": "0.0.0",
  "identifier": "com.raishish.fin-manager",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "fin-manager",
        "width": 1100,
        "height": 720,
        "minWidth": 800,
        "minHeight": 560,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "appimage"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Finance",
    "shortDescription": "Local-first personal finance",
    "longDescription": "Imports your bank files, categorises and explains your spending, and answers questions about your money, with all data encrypted on this computer.",
    "publisher": "fin-manager contributors",
    "copyright": "Copyright the fin-manager contributors. Licensed under AGPL-3.0-or-later.",
    "license": "AGPL-3.0-or-later",
    "licenseFile": "../../LICENSE",
    "homepage": "https://github.com/raishish/fin-manager",
    "createUpdaterArtifacts": false,
    "macOS": {
      "signingIdentity": "-",
      "hardenedRuntime": true,
      "minimumSystemVersion": "11.0"
    },
    "linux": {
      "appimage": {
        "bundleMediaFramework": false
      }
    }
  }
}
